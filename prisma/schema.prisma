generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String                   @id @default(cuid())
  clerkId           String?                  @unique
  name              String
  email             String                   @unique
  password          String?
  phone             String?
  parentPhone       String?
  age               Int?
  educationalStage  String?
  role              String                   @default("student")
  isActive          Boolean                  @default(true)
  isDeleted         Boolean                  @default(false)
  deletedAt         DateTime?
  profileCompleted  Boolean                  @default(false)
  lastLoginAt       DateTime?
  points            Int                      @default(0)
  pointsUpdatedAt   DateTime                 @default(now())
  loginStreak       Int                      @default(0)
  lastLoginDate     DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  aiConversations   AIConversation[]         @relation("StudentAIConversations")
  aiInsights        AIStudentInsight[]       @relation("StudentAIInsights")
  accessCodes       AccessCode[]             @relation("StudentCodes")
  courses           Course[]                 @relation("TeacherCourses")
  teacherProfile    TeacherProfile?
  devices           Device[]
  dailyExamResults  DailyExamResult[]
  studyPlans        DailyStudyPlan[]         @relation("StudentStudyPlans")
  gradeRequests     GradeAdjustmentRequest[] @relation("StudentGradeRequests")
  reviewedGradeReqs GradeAdjustmentRequest[] @relation("TeacherGradeRequests")
  progress          Progress[]
  quizResults       QuizResult[]
  feedbacks         StudentFeedback[]        @relation("StudentFeedbacks")
  receivedFeedbacks StudentFeedback[]        @relation("TeacherFeedbacks")
  assignedTickets   SupportTicket[]          @relation("AssignedTickets")
  supportTickets    SupportTicket[]          @relation("StudentTickets")

  @@index([role])
  @@index([educationalStage])
  @@index([email])
  @@index([isDeleted])
}

model Course {
  id                String                   @id @default(cuid())
  title             String
  subject           String
  description       String?
  thumbnailUrl      String?
  educationalStage  String
  teacherId         String
  isPaid            Boolean                  @default(false)
  price             Float?
  discountPercent   Float?
  discountExpiresAt DateTime?
  contactPhone      String?
  maxWatchCount     Int                      @default(3)
  sequentialAccess  Boolean                  @default(true)
  homeworkUrl       String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  accessCodes       AccessCode[]
  teacher           User                     @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  folders           Folder[]
  gradeRequests     GradeAdjustmentRequest[]
  feedbacks         StudentFeedback[]
  supportTickets    SupportTicket[]

  @@index([teacherId])
  @@index([educationalStage])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String // matches the persistent `device_id` cookie
  label      String?
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model TeacherProfile {
  id          String   @id @default(cuid())
  teacherId   String   @unique
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  slug        String   @unique // "MR-KHALED" → /MR-KHALED
  displayName String?
  bio         String?
  photoUrl    String?
  bannerUrl   String?

  navColor    String?  @default("#0b0f19")
  accentColor String?  @default("#6366f1")

  socials     String? // JSON: { facebook, youtube, tiktok }

  featuredCourseId String?
  isPublished Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model Folder {
  id        String     @id @default(cuid())
  name      String
  order     Int        @default(0)
  courseId  String
  // Scheduled unlock: null = available now; a future date locks the whole folder
  // (and all its videos) until then. Honored in every student content read path.
  publishAt DateTime?
  createdAt DateTime   @default(now())
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials Material[]
  quizzes   Quiz[]
  videos    Video[]

  @@index([courseId])
}

model Video {
  id              String              @id @default(cuid())
  title           String
  // Legacy field — kept for existing rows; new rows use videoProvider + providerVideoId
  vdoCipherId     String              @default("")
  videoProvider   String              @default("vdocipher") // vdocipher | bunny | youtube
  providerVideoId String              @default("")
  durationMinutes    Int                 @default(0)
  maxWatchesPerUser  Int                 @default(3)
  isFree             Boolean             @default(false)
  // Scheduled unlock: null = available now; a future date locks this video until
  // then. Effective unlock = the later of this and the folder's publishAt.
  publishAt          DateTime?
  order              Int                 @default(0)
  folderId        String
  createdAt       DateTime            @default(now())
  progress        Progress[]
  folder          Folder              @relation(fields: [folderId], references: [id], onDelete: Cascade)
  watchSessions   VideoWatchSession[]

  @@index([folderId])
}

model VideoWatchSession {
  id            String    @id @default(cuid())
  sessionToken  String    @unique @default(cuid())
  videoId       String
  studentId     String
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  endedAt       DateTime?
  usedWatchSlot Boolean   @default(true)
  ipAddress     String?
  userAgent     String?
  video         Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([studentId])
  @@index([sessionToken])
}

model Quiz {
  id               String                   @id @default(cuid())
  title            String
  timeLimitMinutes Int                      @default(30)
  folderId         String
  createdAt        DateTime                 @default(now())
  gradeRequests    GradeAdjustmentRequest[]
  folder           Folder                   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  questions        QuizQuestion[]
  results          QuizResult[]

  @@index([folderId])
}

model Material {
  id        String   @id @default(cuid())
  title     String
  url       String
  type      String
  order     Int      @default(0)
  folderId  String
  createdAt DateTime @default(now())
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  order         Int    @default(0)
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model AccessCode {
  id        String    @id @default(cuid())
  code      String    @unique
  courseId  String
  studentId String?
  isActive  Boolean   @default(true)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User?     @relation("StudentCodes", fields: [studentId], references: [id])

  @@index([courseId])
  @@index([studentId])
  @@index([isActive])
}

model Progress {
  id        String    @id @default(cuid())
  studentId String
  videoId   String
  watched   Boolean   @default(false)
  watchedAt DateTime?
  // Resume playback: last position kept per (student, video) — NOT per watch
  // session — so it survives a 4h-slot expiry. A student cut off mid-video on
  // their last watch resumes where they stopped, not at zero.
  lastPositionSeconds Int       @default(0)
  positionUpdatedAt   DateTime?
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([studentId, videoId])
  @@index([studentId])
  @@index([videoId])
}

model QuizResult {
  id          String   @id @default(cuid())
  studentId   String
  quizId      String
  score       Float
  totalQ      Int
  allowRetake Boolean  @default(false)
  completedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, quizId])
  @@index([studentId])
  @@index([quizId])
}

model DailyStudyPlan {
  id            String   @id @default(cuid())
  studentId     String
  planDate      DateTime
  content       String
  status        String   @default("pending")
  lastUpdatedAt DateTime @updatedAt
  createdAt     DateTime @default(now())
  student       User     @relation("StudentStudyPlans", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, planDate])
  @@index([studentId])
  @@index([planDate])
}

model CourseAnalytics {
  id               String   @id @default(cuid())
  courseId         String   @unique
  totalEnrollments Int      @default(0)
  totalViews       Int      @default(0)
  averageScore     Float    @default(0)
  lastUpdatedAt    DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model ClientError {
  id        String   @id @default(cuid())
  type      String
  message   String
  stack     String?
  url       String?
  userAgent String?
  userId    String?
  userRole  String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  adminId    String
  adminName  String
  action     String
  targetType String
  targetId   String
  targetName String
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([adminId])
  @@index([createdAt])
}

model AIConversation {
  id        String   @id @default(cuid())
  studentId String
  role      String
  content   String
  context   String?
  actions   String?
  createdAt DateTime @default(now())
  student   User     @relation("StudentAIConversations", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
}

model StudentFeedback {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  teacherId  String
  type       String
  rating     Int?
  content    String
  isResolved Boolean  @default(false)
  resolution String?
  aiAnalyzed Boolean  @default(false)
  aiInsights String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    User     @relation("StudentFeedbacks", fields: [studentId], references: [id], onDelete: Cascade)
  teacher    User     @relation("TeacherFeedbacks", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([teacherId])
  @@index([type])
  @@index([createdAt])
}

model GradeAdjustmentRequest {
  id             String    @id @default(cuid())
  studentId      String
  quizId         String
  courseId       String
  requestedBy    String
  currentScore   Float
  requestedScore Float?
  reason         String
  aiAnalysis     String?
  evidence       String?
  status         String    @default("pending")
  teacherId      String?
  teacherNotes   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz           Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student        User      @relation("StudentGradeRequests", fields: [studentId], references: [id], onDelete: Cascade)
  teacher        User?     @relation("TeacherGradeRequests", fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([courseId])
  @@index([teacherId])
  @@index([status])
  @@index([createdAt])
}

model AIStudentInsight {
  id           String   @id @default(cuid())
  studentId    String
  type         String
  category     String
  title        String
  description  String
  confidence   Float
  dataSnapshot String
  isRead       Boolean  @default(false)
  isActioned   Boolean  @default(false)
  actionTaken  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      User     @relation("StudentAIInsights", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([type])
  @@index([category])
  @@index([createdAt])
}

model SupportTicket {
  id           String   @id @default(cuid())
  studentId    String
  courseId     String?
  title        String
  description  String
  type         String
  priority     String   @default("normal")
  status       String   @default("open")
  aiHandled    Boolean  @default(false)
  aiResponse   String?
  assignedTo   String?
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedUser User?    @relation("AssignedTickets", fields: [assignedTo], references: [id])
  course       Course?  @relation(fields: [courseId], references: [id])
  student      User     @relation("StudentTickets", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model DailyExam {
  id               String              @id @default(cuid())
  title            String
  educationalStage String
  date             DateTime
  timeLimitMinutes Int                 @default(30)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  questions        DailyExamQuestion[]
  results          DailyExamResult[]

  @@index([educationalStage])
  @@index([date])
  @@index([isActive])
}

model DailyExamQuestion {
  id            String    @id @default(cuid())
  examId        String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  order         Int       @default(0)
  exam          DailyExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model DailyExamResult {
  id          String    @id @default(cuid())
  studentId   String
  examId      String
  score       Float
  totalQ      Int
  completedAt DateTime  @default(now())
  exam        DailyExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, examId])
  @@index([studentId])
  @@index([examId])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String                   @id @default(cuid())
  clerkId           String?                  @unique
  name              String
  email             String                   @unique
  password          String?
  phone             String?
  parentPhone       String?
  age               Int?
  educationalStage  String?
  role              String                   @default("student")
  isActive          Boolean                  @default(true)
  isDeleted         Boolean                  @default(false)
  deletedAt         DateTime?
  // Owner superadmin (Ahmed): may manage the other superadmins. Only one is true.
  isOwner           Boolean                  @default(false)
  // Demo/seed account generated by the owner's virtual-data tool — safe to purge.
  isVirtual         Boolean                  @default(false)
  profileCompleted  Boolean                  @default(false)
  lastLoginAt       DateTime?
  points            Int                      @default(0)
  pointsUpdatedAt   DateTime                 @default(now())
  loginStreak       Int                      @default(0)
  lastLoginDate     DateTime?
  streakFreezes     Int                      @default(0)
  referralCode      String?                  @unique
  referredById      String?
  balance           Float                    @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  aiConversations   AIConversation[]         @relation("StudentAIConversations")
  aiInsights        AIStudentInsight[]       @relation("StudentAIInsights")
  accessCodes       AccessCode[]             @relation("StudentCodes")
  courses           Course[]                 @relation("TeacherCourses")
  teacherProfile    TeacherProfile?
  devices           Device[]
  dailyExamResults  DailyExamResult[]
  studyPlans        DailyStudyPlan[]         @relation("StudentStudyPlans")
  gradeRequests     GradeAdjustmentRequest[] @relation("StudentGradeRequests")
  reviewedGradeReqs GradeAdjustmentRequest[] @relation("TeacherGradeRequests")
  progress          Progress[]
  quizResults       QuizResult[]
  feedbacks         StudentFeedback[]        @relation("StudentFeedbacks")
  receivedFeedbacks StudentFeedback[]        @relation("TeacherFeedbacks")
  assignedTickets   SupportTicket[]          @relation("AssignedTickets")
  supportTickets    SupportTicket[]          @relation("StudentTickets")
  notifications        Notification[]
  balanceTransactions  BalanceTransaction[]
  homeworkSubmissions  HomeworkSubmission[]
  teacherHomeworks     Homework[]           @relation("TeacherHomework")
  iqData               String?              // JSON blob: IQData from iq-system.ts
  overallIQ            Int                  @default(1000)

  @@index([role])
  @@index([educationalStage])
  @@index([email])
  @@index([isDeleted])
}

model Course {
  id                String                   @id @default(cuid())
  title             String
  // SEO-friendly English URL slug, e.g. "math-secondary-3-ab12cd". Nullable so
  // existing rows keep working (resolved by id-or-slug); backfilled by script.
  slug              String?                  @unique
  subject           String
  description       String?
  thumbnailUrl      String?
  educationalStage  String
  teacherId         String
  isPaid            Boolean                  @default(false)
  price             Float?
  discountPercent   Float?
  discountExpiresAt DateTime?
  contactPhone      String?
  maxWatchCount     Int                      @default(3)
  sequentialAccess   Boolean                  @default(true)
  enableWatchedButton Boolean                 @default(false)
  homeworkUrl        String?
  allowDirectInstall Boolean                  @default(false)
  // Demo course generated by the owner's virtual-data tool — safe to purge.
  isVirtual         Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  accessCodes       AccessCode[]
  teacher           User                     @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  folders           Folder[]
  gradeRequests     GradeAdjustmentRequest[]
  feedbacks         StudentFeedback[]
  supportTickets    SupportTicket[]

  @@index([teacherId])
  @@index([educationalStage])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Superadmin-editable platform constants (JWT expiry, watch rules, limits, …).
/// Values are stored as strings; `type` says how to coerce them.
model PlatformConfig {
  key       String   @id
  value     String
  type      String // number | string | boolean
  category  String
  label     String
  updatedAt DateTime @updatedAt @default(now())
}

/// A configurable AI provider for study-plan generation. `apiKeyEnc` is an
/// AES-256-GCM ciphertext (CONFIG_ENCRYPTION_KEY) and is NEVER returned to the
/// client — the API exposes only a `hasKey` boolean.
model AIProvider {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  baseUrl   String
  models    String // JSON array of model id strings
  apiKeyEnc String? // AES-256-GCM, never returned to the client
  isPrimary Boolean  @default(false)
  isBackup  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A superadmin-initiated bulk account wipe. Scheduled requests wait `executeAt`
/// (default +7 days) before the targeted accounts are soft-deleted; `instant`
/// requests run immediately (gated by BULK_DELETE_PASSWORD). Soft-deleted users
/// land in the existing trash and are purged permanently 30 days later.
model BulkDeletionRequest {
  id              String    @id @default(cuid())
  scope           String // "all" (students+teachers) | "students" | "teachers"
  status          String    @default("pending") // pending | executed | cancelled
  instant         Boolean   @default(false)
  requestedById   String
  requestedByName String
  requestedAt     DateTime  @default(now())
  executeAt       DateTime // when the soft-delete runs
  executedAt      DateTime?
  cancelledAt     DateTime?
  affectedCount   Int?
  createdAt       DateTime  @default(now())

  @@index([status, executeAt])
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String // matches the persistent `device_id` cookie
  label      String?
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model TeacherProfile {
  id          String   @id @default(cuid())
  teacherId   String   @unique
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  slug        String   @unique // "MR-KHALED" → /MR-KHALED
  displayName String?
  bio         String?
  photoUrl    String?
  bannerUrl   String?

  navColor    String?  @default("#0b0f19")
  accentColor String?  @default("#6366f1")

  socials     String? // JSON: { facebook, youtube, tiktok }

  featuredCourseId String?
  isPublished Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model Folder {
  id        String     @id @default(cuid())
  name      String
  order     Int        @default(0)
  courseId  String
  // Scheduled unlock: null = available now; a future date locks the whole folder
  // (and all its videos) until then. Honored in every student content read path.
  publishAt DateTime?
  createdAt DateTime   @default(now())
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials Material[]
  quizzes   Quiz[]
  videos    Video[]

  @@index([courseId])
}

model Video {
  id              String              @id @default(cuid())
  title           String
  // Legacy field — kept for existing rows; new rows use videoProvider + providerVideoId
  vdoCipherId     String              @default("")
  videoProvider   String              @default("vdocipher") // vdocipher | bunny | youtube
  providerVideoId String              @default("")
  durationMinutes    Int                 @default(0)
  maxWatchesPerUser  Int                 @default(3)
  isFree             Boolean             @default(false)
  // Scheduled unlock: null = available now; a future date locks this video until
  // then. Effective unlock = the later of this and the folder's publishAt.
  publishAt          DateTime?
  order              Int                 @default(0)
  folderId        String
  createdAt       DateTime            @default(now())
  progress        Progress[]
  folder          Folder              @relation(fields: [folderId], references: [id], onDelete: Cascade)
  watchSessions   VideoWatchSession[]
  questions       VideoQuestion[]

  @@index([folderId])
}

model VideoWatchSession {
  id            String    @id @default(cuid())
  sessionToken  String    @unique @default(cuid())
  videoId       String
  studentId     String
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  endedAt       DateTime?
  usedWatchSlot Boolean   @default(true)
  ipAddress     String?
  userAgent     String?
  video         Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([studentId])
  @@index([sessionToken])
}

model Quiz {
  id                  String                   @id @default(cuid())
  title               String
  timeLimitMinutes    Int                      @default(30)
  retakeCooldownHours Int                      @default(0)
  folderId            String
  createdAt        DateTime                 @default(now())
  gradeRequests    GradeAdjustmentRequest[]
  folder           Folder                   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  questions        QuizQuestion[]
  results          QuizResult[]

  @@index([folderId])
}

model Material {
  id        String   @id @default(cuid())
  title     String
  url       String
  type      String
  order     Int      @default(0)
  folderId  String
  createdAt DateTime @default(now())
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  order         Int    @default(0)
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model AccessCode {
  id        String    @id @default(cuid())
  code      String    @unique
  courseId  String
  studentId String?
  isActive  Boolean   @default(true)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User?     @relation("StudentCodes", fields: [studentId], references: [id])

  @@index([courseId])
  @@index([studentId])
  @@index([isActive])
}

model Progress {
  id        String    @id @default(cuid())
  studentId String
  videoId   String
  watched   Boolean   @default(false)
  watchedAt DateTime?
  // Resume playback: last position kept per (student, video) — NOT per watch
  // session — so it survives a 4h-slot expiry. A student cut off mid-video on
  // their last watch resumes where they stopped, not at zero.
  lastPositionSeconds Int       @default(0)
  positionUpdatedAt   DateTime?
  // Cumulative real playback time — server-side increment only (anti-cheat).
  watchedSecondsTotal Float     @default(0)
  // Recency marker for "Continue Watching" UI ordering.
  lastWatchedAt       DateTime  @default(now())
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([studentId, videoId])
  @@index([studentId])
  @@index([videoId])
}

model QuizResult {
  id          String   @id @default(cuid())
  studentId   String
  quizId      String
  score       Float
  totalQ      Int
  allowRetake Boolean  @default(false)
  startedAt   DateTime?
  completedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@unique([studentId, quizId])
  @@index([studentId])
  @@index([quizId])
}

/// Per-question answer record saved on every quiz submission.
/// Powers "view answers" modal + "wrong-questions exam" feature.
model QuizAnswer {
  id             String     @id @default(cuid())
  studentId      String
  quizId         String
  questionId     String
  resultId       String
  selectedAnswer String?    // null = skipped
  correctAnswer  String
  isCorrect      Boolean
  question       String     // snapshot so it works even if question is later edited
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  createdAt      DateTime   @default(now())
  result         QuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([studentId, isCorrect])
  @@index([quizId])
  @@index([resultId])
  @@index([questionId])
}

model DailyStudyPlan {
  id            String   @id @default(cuid())
  studentId     String
  planDate      DateTime
  content       String
  status        String   @default("pending")
  lastUpdatedAt DateTime @updatedAt
  createdAt     DateTime @default(now())
  student       User     @relation("StudentStudyPlans", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, planDate])
  @@index([studentId])
  @@index([planDate])
}

model CourseAnalytics {
  id               String   @id @default(cuid())
  courseId         String   @unique
  totalEnrollments Int      @default(0)
  totalViews       Int      @default(0)
  averageScore     Float    @default(0)
  lastUpdatedAt    DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model ClientError {
  id        String   @id @default(cuid())
  type      String
  message   String
  stack     String?
  url       String?
  userAgent String?
  userId    String?
  userRole  String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  adminId    String
  adminName  String
  action     String
  targetType String
  targetId   String
  targetName String
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([adminId])
  @@index([createdAt])
}

model AIConversation {
  id        String   @id @default(cuid())
  studentId String
  role      String
  content   String
  context   String?
  actions   String?
  createdAt DateTime @default(now())
  student   User     @relation("StudentAIConversations", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
}

model StudentFeedback {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  teacherId  String
  type       String
  rating     Int?
  content    String
  isResolved Boolean  @default(false)
  resolution String?
  aiAnalyzed Boolean  @default(false)
  aiInsights String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    User     @relation("StudentFeedbacks", fields: [studentId], references: [id], onDelete: Cascade)
  teacher    User     @relation("TeacherFeedbacks", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([teacherId])
  @@index([type])
  @@index([createdAt])
}

model GradeAdjustmentRequest {
  id             String    @id @default(cuid())
  studentId      String
  quizId         String
  courseId       String
  requestedBy    String
  currentScore   Float
  requestedScore Float?
  reason         String
  aiAnalysis     String?
  evidence       String?
  status         String    @default("pending")
  teacherId      String?
  teacherNotes   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz           Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student        User      @relation("StudentGradeRequests", fields: [studentId], references: [id], onDelete: Cascade)
  teacher        User?     @relation("TeacherGradeRequests", fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([courseId])
  @@index([teacherId])
  @@index([status])
  @@index([createdAt])
}

model AIStudentInsight {
  id           String   @id @default(cuid())
  studentId    String
  type         String
  category     String
  title        String
  description  String
  confidence   Float
  dataSnapshot String
  isRead       Boolean  @default(false)
  isActioned   Boolean  @default(false)
  actionTaken  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      User     @relation("StudentAIInsights", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([type])
  @@index([category])
  @@index([createdAt])
}

model SupportTicket {
  id           String   @id @default(cuid())
  studentId    String
  courseId     String?
  title        String
  description  String
  type         String
  priority     String   @default("normal")
  status       String   @default("open")
  aiHandled    Boolean  @default(false)
  aiResponse   String?
  assignedTo   String?
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedUser User?    @relation("AssignedTickets", fields: [assignedTo], references: [id])
  course       Course?  @relation(fields: [courseId], references: [id])
  student      User     @relation("StudentTickets", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model DailyExam {
  id               String              @id @default(cuid())
  title            String
  educationalStage String
  date             DateTime
  timeLimitMinutes Int                 @default(30)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  questions        DailyExamQuestion[]
  results          DailyExamResult[]

  @@index([educationalStage])
  @@index([date])
  @@index([isActive])
}

model DailyExamQuestion {
  id            String    @id @default(cuid())
  examId        String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  order         Int       @default(0)
  exam          DailyExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model DailyExamResult {
  id          String    @id @default(cuid())
  studentId   String
  examId      String
  score       Float
  totalQ      Int
  completedAt DateTime  @default(now())
  exam        DailyExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, examId])
  @@index([studentId])
  @@index([examId])
}

// ── In-Video Timed Questions ────────────────────────────────────────────────

/// A question anchored to a specific timestamp in a video. Teachers choose
/// between "pause" (blocks playback until answered) and "overlay" (non-blocking
/// banner, video keeps playing). The question fires only when the student's
/// playhead actually passes through triggerSecond during normal playback — not
/// on a raw seek.
model VideoQuestion {
  id              String   @id @default(cuid())
  videoId         String
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  triggerSecond   Int                  // e.g. 691 for 11:31
  mode            String   @default("pause") // "pause" | "overlay"
  questionText    String
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctOption   String   // "A" | "B" | "C" | "D"
  explanation     String?
  refireOnRewatch Boolean  @default(false)
  createdAt       DateTime @default(now())
  responses       VideoQuestionResponse[]

  @@index([videoId])
}

/// Records a student's answer to a VideoQuestion within a specific watch session.
/// The unique constraint prevents double-answering in the same session.
model VideoQuestionResponse {
  id               String        @id @default(cuid())
  videoQuestionId  String
  videoQuestion    VideoQuestion @relation(fields: [videoQuestionId], references: [id], onDelete: Cascade)
  studentId        String
  selectedOption   String
  isCorrect        Boolean
  answeredAtSecond Int           // actual currentTime when answered, for analytics
  watchSessionId   String?       // ties response to a specific viewing
  createdAt        DateTime      @default(now())

  @@unique([videoQuestionId, studentId, watchSessionId])
  @@index([videoQuestionId])
  @@index([studentId])
}

/// In-app notifications for students (streak milestones, new exams, grade outcomes, etc.)
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // streak_milestone | exam_live | grade_resolved | referral_joined
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ── Wallet ──────────────────────────────────────────────────────────────────

/// Every credit/debit against a student's balance. Immutable audit trail.
model BalanceTransaction {
  id        String   @id @default(cuid())
  userId    String
  /// credit_admin | credit_code | debit_course
  type      String
  amount    Float    // positive = credit, negative = debit
  note      String?  // admin note or code used
  adminId   String?  // who credited (if type=credit_admin)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

/// Superadmin-generated recharge codes students can enter to top up their balance.
model MoneyCode {
  id        String    @id @default(cuid())
  code      String    @unique
  amount    Float
  isUsed    Boolean   @default(false)
  usedById  String?
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([code])
  @@index([isUsed])
}

// ── Homework ─────────────────────────────────────────────────────────────────

/// Teacher-created homework. type=link → just a URL. type=exam → MCQ with optional image URLs.
/// Images are stored as external URLs only — no file uploads, zero storage cost.
model Homework {
  id               String              @id @default(cuid())
  teacherId        String
  courseId         String?             // optional: link to a course
  title            String
  description      String?
  type             String              @default("link") // "link" | "exam"
  linkUrl          String?             // for type=link
  dueAt            DateTime?
  isPublished      Boolean             @default(false)
  timeLimitMinutes Int                 @default(30)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  teacher          User                @relation("TeacherHomework", fields: [teacherId], references: [id], onDelete: Cascade)
  questions        HomeworkQuestion[]
  submissions      HomeworkSubmission[]

  @@index([teacherId])
  @@index([courseId])
  @@index([isPublished])
}

model HomeworkQuestion {
  id            String   @id @default(cuid())
  homeworkId    String
  question      String
  imageUrl      String?  // external URL only (Google Drive / ImgBB / etc.)
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   // "A" | "B" | "C" | "D"
  order         Int      @default(0)
  homework      Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@index([homeworkId])
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  homeworkId  String
  studentId   String
  answers     String   // JSON: { questionId: selectedOption }
  score       Float?
  totalQ      Int?
  completedAt DateTime @default(now())
  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@index([homeworkId])
}

model LeaderboardCache {
  key       String   @id
  data      String   // Stores computed leaderboard JSON
  updatedAt DateTime @default(now()) @updatedAt
}


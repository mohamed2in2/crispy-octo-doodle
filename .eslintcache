efined but never used.","'checkElementMotion' is defined but never used.","'checkElementGlow' is defined but never used.","'checkPageTypography' is defined but never used.","'checkPageLayout' is defined but never used.","'checkElementOversizedH1' is defined but never used.","'checkElementGptBorderShadow' is defined but never used.","'checkElementClippedOverflow' is defined but never used.","'customPropMap' is defined but never used.","'RGBA_RE' is assigned a value but never used.","'BOX_SHADOW_RE' is assigned a value but never used.","'NAMED_RULE_RE' is assigned a value but never used.","'scanInlineColors' is defined but never used.","'parseStitchInlineGroups' is defined but never used.","'_reason' is assigned a value but never used.","'cssId' is assigned a value but never used.","'configureModifierPillStyle' is defined but never used.","'bindConfigureModifierPillHover' is defined but never used.","'paramsPanelInner' is assigned a value but never used.","'why' is defined but never used.","'prevTarget' is assigned a value but never used.","'commitAcceptedVariantToDom' is defined but never used.","'loadPickPref' is defined but never used.","'savePickPref' is defined but never used.","'PAGE_CHAT_PROCESSING_W' is assigned a value but never used.","'_theme' is defined but never used.","'reason' is defined but never used.","'count' is defined but never used.","'highlightBold' is defined but never used.","'_syntax' is defined but never used.","'matchedQuery' is assigned a value but never used.","'outputLines' is defined but never used.","'attrEscapeDouble' is defined but never used.","@typescript-eslint/no-unused-expressions","Expected an assignment or function call and instead saw an expression.","ExpressionStatement","unusedExpression","'L' is assigned a value but never used.","'C' is assigned a value but never used.","'readdirSync' is defined but never used.",["5414"],["5415"],["5416"],["5417"],"'fileURLToPath' is defined but never used.",["5418"],"'init' is defined but never used.","'ConfigManager' is defined but never used.",["5419"],"'MockProvider' is defined but never used.",["5420"],"'OpenAICompatibleProvider' is defined but never used.",["5421"],"@typescript-eslint/no-explicit-any","Unexpected any. Specify a different type.","TSAnyKeyword","unexpectedAny",["5422","5423"],"@typescript-eslint/ban-ts-comment","Use \"@ts-expect-error\" instead of \"@ts-ignore\", as \"@ts-ignore\" will do nothing if the following line is error-free.","Line","tsIgnoreInsteadOfExpectError",["5424"],["5425","5426"],["5427","5428"],["5429","5430"],["5431","5432"],"'StudentObservationEngine' is defined but never used.",["5433"],"'PlatformContextInjector' is defined but never used.",["5434"],"'TaskModelRouter' is defined but never used.",["5435"],"'ToolCache' is defined but never used.",["5436"],"'AdvancedRateLimiter' is defined but never used.",["5437"],"'SafetyRules' is defined but never used.",["5438"],"'testSuffix' is assigned a value but never used.",["5439","5440"],["5441","5442"],["5443","5444"],["5445","5446"],"'TeachingStrategyAdapter' is defined but never used.",["5447"],"'TaskOptimizer' is defined but never used.",["5448"],"'PromptOptimizer' is defined but never used.",["5449"],"'ResponseOptimizer' is defined but never used.",["5450"],"'EvaluationFramework' is defined but never used.",["5451"],"'PromptBudgetManager' is defined but never used.",["5452"],"'params' is defined but never used.","'BudgetAlerts' is defined but never used.",["5453"],"'ProviderMonitor' is defined but never used.",["5454"],["5455","5456"],["5457","5458"],["5459","5460"],"'stopAtLayer' is assigned a value but never used.","'options' is defined but never used.","'prompt' is defined but never used.","'found' is assigned a value but never used.","'secretKey' is assigned a value but never used.","prefer-const","'optimized' is never reassigned. Use 'const' instead.","useConst",{"range":"5461","text":"5462"},["5463","5464"],["5465","5466"],["5467","5468"],["5469","5470"],["5471","5472"],"'planData' is assigned a value but never used.",["5473","5474"],"'ctx' is defined but never used.","react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/home/runner/work/crispy-octo-doodle/crispy-octo-doodle/src/app/(admin)/admin/security/page.tsx:68:10\n  66 |\n  67 |   useEffect(() => {\n> 68 |     void fetchTelemetry();\n     |          ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  69 |     const interval = setInterval(fetchTelemetry, 30000); // Auto-refresh every 30s\n  70 |     return () => clearInterval(interval);\n  71 |   }, []);","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/home/runner/work/crispy-octo-doodle/crispy-octo-doodle/src/app/(clerk)/account/page.tsx:107:5\n  105 |\n  106 |   useEffect(() => {\n> 107 |     setIqData(getIQData());\n      |     ^^^^^^^^^ Avoid calling setState() directly within an effect\n  108 |     const handler = () => setIqData(getIQData());\n  109 |     window.addEventListener(\"storage\", handler);\n  110 |     return () => window.removeEventListener(\"storage\", handler);",["5475","5476"],["5477","5478"],"react-hooks/exhaustive-deps","React Hook useCallback has missing dependencies: 'EMPTY_STATS' and 'plans'. Either include them or remove the dependency array.","ArrayExpression",["5479"],["5480"],"'Footer' is defined but never used.",["5481"],"'AnimatePresence' is defined but never used.",["5482"],"'alleles' is never reassigned. Use 'const' instead.",{"range":"5483","text":"5484"},"react-hooks/immutability","Error: Cannot access variable before it is declared\n\n`nextQ` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\n/home/runner/work/crispy-octo-doodle/crispy-octo-doodle/src/app/(clerk)/environments/biology/page.tsx:577:43\n  575 |         tStartRef.current = now;\n  576 |         streakRef.current = 0;\n> 577 |         advRef.current = setTimeout(() => nextQ(idx + 1), 1500);\n      |                                           ^^^^^ `nextQ` accessed before it is declared\n  578 |       }\n  579 |     }, 100);\n  580 |     tStartRef.current = Date.now();\n\n/home/runner/work/crispy-octo-doodle/crispy-octo-doodle/src/app/(clerk)/environments/biology/page.tsx:535:3\n  533 |   };\n  534 |\n> 535 |   const nextQ = useCallback((idx: number) => {\n      |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 536 |     if (idx >= TOTAL_Q) {\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^\n> 537 |       const avgLevel = levelsRef.current.reduce((a, b) => a + b, 0) / levelsRef.current.length;\n      …\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^\n> 581 |   // eslint-disable-next-line react-hooks/exhaustive-deps\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^\n> 582 |   }, [onFinish]);\n      | ^^^^^^^^^^^^^^^^^^ `nextQ` is declared here\n  583 |\n  584 |   const start = () => {\n  585 |     clear();","Unused eslint-disable directive (no problems were reported from 'react-hooks/exhaustive-deps').",{"range":"5485","text":"5486"},{"range":"5487","text":"5486"},"react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/home/runner/work/crispy-octo-doodle/crispy-octo-doodle/src/app/(clerk)/environments/biology/page.tsx:673:85\n  671 |       <div style={{ fontSize: 52 }}>{result.correct >= 8 ? \"🏆\" : result.correct >= 5 ? \"⭐\" : \"💪\"}</div>\n  672 |       <h3 className=\"text-2xl font-black mb-1\" style={{ color: \"var(--ink)\" }}>{result.correct}/{TOTAL_Q} صحيح</h3>\n> 673 |       <p className=\"text-xs text-gray-500 mb-3\">أعلى مستوى وصلت له: Lv.{Math.max(...levelsRef.current)}</p>\n      |                                                                                     ^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  674 |       <div className=\"rounded-xl p-4 my-4\" style={{ background: \"var(--brand-soft)\", border: \"1px solid var(--brand)\" }}>\n  675 |         <div className=\"text-xs font-bold mb-1\" style={{ color: \"var(--brand)\" }}>نقاط الجلسة</div>\n  676 |         <div className=\"text-3xl font-black\" style={{ color: \"var(--brand)\" }}>{result.sessionScore.toLocaleString(\"ar-EG\")}</div>","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your co
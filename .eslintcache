);","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\ui\\YouTubeSecurePlayer.tsx:98:3\n   96 |   onTimeUpdateRef.current = onTimeUpdate;\n   97 |   const onPauseRef = useRef(onPause);\n>  98 |   onPauseRef.current = onPause;\n      |   ^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n   99 |   const onPlayRef = useRef(onPlay);\n  100 |   onPlayRef.current = onPlay;\n  101 |   const startRef = useRef(startSeconds);","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\ui\\YouTubeSecurePlayer.tsx:100:3\n   98 |   onPauseRef.current = onPause;\n   99 |   const onPlayRef = useRef(onPlay);\n> 100 |   onPlayRef.current = onPlay;\n      |   ^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  101 |   const startRef = useRef(startSeconds);\n  102 |   startRef.current = startSeconds;\n  103 |   const seekedRef = useRef(false);","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\ui\\YouTubeSecurePlayer.tsx:102:3\n  100 |   onPlayRef.current = onPlay;\n  101 |   const startRef = useRef(startSeconds);\n> 102 |   startRef.current = startSeconds;\n      |   ^^^^^^^^^^^^^^^^ Cannot update ref during render\n  103 |   const seekedRef = useRef(false);\n  104 |   const lastReportRef = useRef(0);\n  105 |","'lastReportRef' is assigned a value but never used.","'poll' is never reassigned. Use 'const' instead.","'BACKUP_API_KEY' is assigned a value but never used.","'_messages' is defined but never used.","'stage' is defined but never used.",["2891","2892"],["2893","2894"],["2895","2896"],["2897","2898"],["2899","2900"],["2901","2902"],["2903","2904"],["2905","2906"],["2907","2908"],"Unused eslint-disable directive (no problems were reported from '@typescript-eslint/no-var-requires').",{"range":"2909","text":"2720"},"'modelKey' is defined but never used.","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nJ:\\crispy-octo-doodle-1\\src\\lib\\use-position-saver.ts:17:3\n  15 |   const timerRef = useRef<ReturnType<typeof setInterval> | null>(null);\n  16 |   const videoIdRef = useRef(videoId);\n> 17 |   videoIdRef.current = videoId;\n     |   ^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  18 |\n  19 |   // Send position to server\n  20 |   const flush = useCallback(async () => {",["2910","2911"],["2912","2913"],["2914","2915"],["2916","2917"],["2918","2919"],["2920","2921"],{"messageId":"2922","data":"2923","fix":"2924","desc":"2925"},{"kind":"2926","justification":"2927"},{"kind":"2926","justification":"2927"},{"messageId":"2928","data":"2929","fix":"2930","desc":"2931"},{"messageId":"2932","fix":"2933","desc":"2934"},{"messageId":"2935","fix":"2936","desc":"2937"},{"messageId":"2932","fix":"2938","desc":"2934"},{"messageId":"2935","fix":"2939","desc":"293
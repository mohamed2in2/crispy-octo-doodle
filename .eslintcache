ssionStatement","unusedExpression","'L' is assigned a value but never used.","'C' is assigned a value but never used.","'readdirSync' is defined but never used.",["1856"],"@typescript-eslint/no-require-imports","A `require()` style import is forbidden.","CallExpression","noRequireImports",["1857"],["1858"],"'fileURLToPath' is defined but never used.",["1859"],"@typescript-eslint/no-explicit-any","Unexpected any. Specify a different type.","TSAnyKeyword","unexpectedAny",["1860","1861"],["1862","1863"],"'Footer' is defined but never used.",["1864"],"'AnimatePresence' is defined but never used.",["1865"],"react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'runCode'. Either include it or remove the dependency array.","ArrayExpression",["1866"],"'staggerContainerVariants' is defined but never used.",["1867"],"'staggerItemVariants' is defined but never used.",["1868"],"'totalVideos' is assigned a value but never used.","'totalQuizzes' is assigned a value but never used.","react-hooks/purity","Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nJ:\\crispy-octo-doodle-1\\src\\app\\(clerk)\\library\\page.tsx:282:45\n  280 |                     {Array.from({ length: 7 }).map((_, i) => {\n  281 |                       const dayLetters = [\"ح\", \"ن\", \"ث\", \"ر\", \"خ\", \"ج\", \"س\"]; // Sun..Sat\n> 282 |                       const date = new Date(Date.now() - (6 - i) * 86400000);\n      |                                             ^^^^^^^^^^ Cannot call impure function\n  283 |                       const isToday = i === 6;\n  284 |                       const active = stats?.weekActive?.[i] ?? false;\n  285 |                       return (","'Plus' is defined but never used.",["1869"],"'Clock' is defined but never used.",["1870"],"'XCircle' is defined but never used.",["1871"],"React Hook useEffect has a missing dependency: 'fetchTeachers'. Either include it or remove the dependency array.",["1872"],"@next/next/no-img-element","Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` or a custom image loader to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","JSXOpeningElement","'req' is defined but never used.","'MIN_QUESTIONS' is assigned a value but never used.","'MAX_OPTIONS' is assigned a value but never used.",["1873","1874"],["1875"],"'error' is defined but never used.",["1876","1877"],["1878","1879"],["1880","1881"],["1882"],["1883","1884"],["1885"],["1886","1887"],["1888"],["1889","1890"],["1891"],["1892","1893"],["1894"],["1895","1896"],["1897"],"'_ca' is assigned a value but never used.",["1898","1899"],["1900"],["1901","1902"],["1903"],["1904","1905"],["1906"],["1907","1908"],["1909"],["1910","1911"],["1912"],["1913","1914"],["1915"],["1916","1917"],["1918","1919"],["1920","1921"],"Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nJ:\\crispy-octo-doodle-1\\src\\app\\courses\\[id]\\learn\\page.tsx:206:34\n  204 |   const [elapsedSeconds, setElapsedSeconds] = useState(0);\n  205 |   const [completing, setCompleting] = useState(false);\n> 206 |   const [now, setNow] = useState(Date.now());\n      |                                  ^^^^^^^^^^ Cannot call impure function\n  207 |\n  208 |   // Watch modal\n  209 |   const [modalVideo, setModalVideo] = useState<{ id: string; title: string } | null>(null);","react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\app\\courses\\[id]\\learn\\page.tsx:296:40\n  294 |   }, []);\n  295 |\n> 296 |   useEffect(() => { if (courseId) void loadCourse(); }, [courseId, loadCourse]);\n      |                                        ^^^^^^^^^^ Avoid calling setState() directly within an effect\n  297 |\n  298 |   // ── Countdown ticker ─────────────────────────────────────────────────────\n  299 |","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\app\\courses\\[id]\\learn\\page.tsx:327:20\n  325 |\n  326 |   useEffect(() => {\n> 327 |     if (!player) { setElapsedSeconds(0); return; }\n      |                    ^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  328 |     const tick = () => {\n  329 |       setElapsedSeconds(Math.floor((Date.now() - new Date(player.startedAt).getTime()) / 1000));\n  330 |     };",["1922","1923"],["1924","1925"],"@next/next/no-page-custom-font","Custom fonts not added in `pages/_document.js` will only load for a single page. This is discouraged. See: https://nextjs.org/docs/messages/no-page-custom-font","@next/next/no-html-link-for-pages","Do not use an `<a>` element to navigate to `/leaderboard/`. Use `<Link />` from `next/link` instead. See: https://nextjs.org/docs/messages/no-html-link-for-pages","'Link' is defined but never used.",["1926"],"'Bell' is defined but never used.",["1927"],"'Download' is defined but never used.",["1928"],"'Calendar' is defined but never used.",["1929"],["1930","1931"],["1932","1933"],["1934","1935"],["1936"],["1937"],["1938"],["1939"],["1940"],"React Hook useEffect has a missing dependency: 'setOpen'. Either include it or remove the dependency array.",["1941"],["1942"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\admin\\TeacherFeedback.tsx:55:21\n  53 |   }, [unresolvedOnly]);\n  54 |\n> 55 |   useEffect(() => { load(); }, [load]);\n     |                     ^^^^ Avoid calling setState() directly within an effect\n  56 |\n  57 |   const handleResolve = async () => {\n  58 |     if (!selected) return;","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\admin\\TeacherOverview.tsx:86:26\n  84 |   }, [period, courseId]);\n  85 |\n> 86 |   useEffect(() => { void load(); }, [load]);\n     |                          ^^^^ Avoid calling setState() directly within an effect\n  87 |\n  88 |   const firstName = data?.teacherName?.replace(/^(مستر|مس|د\\.|أ\\.|أستاذة?|دكتور)\\s*/u, \"\").split(\" \")[0] || data?.teacherName;\n  89 |","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\admin\\TeacherPublicProfile.tsx:69:5\n  67 |\n  68 |   useEffect(() => {\n> 69 |     setOrigin(window.location.origin);\n     |     ^^^^^^^^^ Avoid calling setState() directly within an effect\n  70 |     Promise.all([\n  71 |       fetch(\"/api/admin/profile\", { credentials: \"include\" }).then((r) => r.json()),\n  72 |       fetch(\"/api/admin/courses\", { credentials: \"include\" }).then((r) => r.json()).catch(() => ({})),",["1943"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\admin\\TeacherRequests.tsx:90:10\n  88 |\n  89 |   useEffect(() => {\n> 90 |     void load();\n     |          ^^^^ Avoid calling setState() directly within an effect\n  91 |   }, [load]);\n  92 |\n  93 |   const handleGradeAction = async (id: string, action: \"approve\" | \"reject\") => {","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\ai\\StudentInsights.tsx:49:10\n  47 |\n  48 |   useEffect(() => {\n> 49 |     void load();\n     |          ^^^^ Avoid calling setState() directly within an effect\n  50 |   }, [load]);\n  51 |\n  52 |   const refresh = async () => {","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\ai\\StudyPlanCard.tsx:45:10\n  43 |   useEffect(() => {\n  44 |     // Initial data fetch needs to hydrate local component state from the server response.\n> 45 |     void fetchStudyPlan();\n     |          ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  46 |   }, [fetchStudyPlan]);\n  47 |\n  48 |   const generateNewPlan = async () => {",["1944"],"'EASE' is assigned a value but never used.","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\ui\\Navbar.tsx:35:21\n  33 |\n  34 |   /* Close mobile menu on route change */\n> 35 |   useEffect(() => { setMenuOpen(false); }, [pathname]);\n     |                     ^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  36 |\n  37 |   const handleLogout = async () => {\n  38 |     await fetch(\"/api/auth/logout\", { method: \"POST\", credentials: \"include\" });","react-hooks/rules-of-hooks","React Hook \"React.useRef\" is called conditionally. React Hooks must be called in the exact same order in every component render.","MemberExpression","React Hook \"React.useEffect\" is called conditionally. React Hooks must be called in the exact same order in every component render.",["1945","1946"],["1947","1948"],["1949","1950"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\ui\\StreakFlame.tsx:34:19\n  32 |   const [mounted, setMounted] = useState(false);\n  33 |\n> 34 |   useEffect(() => setMounted(true), []);\n     |                   ^^^^^^^^^^ Avoid calling setState() directly within an effect\n  35 |\n  36 |   useEffect(() => {\n  37 |     if (role !== \"student\") return;","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\ui\\StreakFlame.tsx:43:5\n  41 |       .then((d: { streak?: number } | null) => { if (alive && d) setStreak(d.streak ?? 0); })\n  42 |       .catch(() => {});\n> 43 |     setCanNativeShare(typeof navigator !== \"undefined\" && typeof navigator.share === \"function\");\n     |     ^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  44 |     return () => { alive = false; };\n  45 |   }, [role]);\n  46 |","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\ui\\VideoWatermark.tsx:28:5\n  26 |\n  27 |   useEffect(() => {\n> 28 |     setMotionOk(!window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches);\n     |     ^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  29 |\n  30 |     let hideTimer: ReturnType<typeof setTimeout>;\n  31 |     const flash = () => {","react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\ui\\YouTubeSecurePlayer.tsx:85:3\n  83 |   const playerRef = useRef<YTPlayer | null>(null);\n  84 |   const onEndedRef = useRef(onEnded);\n> 85 |   onEndedRef.current = onEnded;\n     |   ^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  86 |   const onProgressRef = useRef(onProgress);\n  87 |   onProgressRef.current = onProgress;\n  88 |   const startRef = useRef(startSeconds);","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\ui\\YouTubeSecurePlayer.tsx:87:3\n  85 |   onEndedRef.current = onEnded;\n  86 |   const onProgressRef = useRef(onProgress);\n> 87 |   onProgressRef.current = onProgress;\n     |   ^^^^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  88 |   const startRef = useRef(startSeconds);\n  89 |   startRef.current = startSeconds;\n  90 |   const seekedRef = useRef(false);","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nJ:\\crispy-octo-doodle-1\\src\\components\\ui\\YouTubeSecurePlayer.tsx:89:3\n  87 |   onProgressRef.current = onProgress;\n  88 |   const startRef = useRef(startSeconds);\n> 89 |   startRef.current = startSeconds;\n     |   ^^^^^^^^^^^^^^^^ Cannot update ref during render\n  90 |   const seekedRef = useRef(false);\n  91 |   const lastReportRef = useRef(0);\n  92 |","prefer-const","'poll' is never reassigned. Use 'const' instead.","useConst","'stage' is defined but never used.","'e' is defined but never used.",["1951","1952"],{"messageId":"1953","data":"1954","fix":"1955","desc":"1956"},{"kind":"1957","justification":"1958"},{"kind":"1957","justification":"1958"},{"messageId":"1959","data":"1960","fix":"1961","desc":"1962"},{"messageId":"1963","fix":"1964","desc":"1965"},{"messageId":"1966","fix":"1967","desc":"1968"},{"messageId":"1963","fix":"1969","desc":"1965"},{"messageId":"1966","fix":"1970","desc":"1968"},{"messageId":"1959","data":"1971","fix":"1972","desc":"1962"},{"messageId":"1953","data":"1973","fix":"1974","desc":"1975"},{"desc":"1976","fix":"1977"},{"messageId":"1953","data":"1978","fix":"1979","desc":"1980"},{"messageId":"1959","data":"1981","fix":"1982","desc":"1962"},{"messageId":"1953","data":"1983","fix":"1984","desc":"1985"},{"messageId":"1953","data":"1986","fix":"1987","desc":"1988"},{"messageId":"1953","data":"1989","fix":"1990","desc":"1991"},{"desc":"1992","fix":"1993"},{"messageId":"1963","fix":"1994","desc":"1965"},{"messageId":"1966","fix":"1995","desc":"1968"},{"kind":"1957","justification":"1958"},{"messageId":"1963","fix":"1996","desc":"1965"},{"messageId":"1966","fix":"1997","desc":"1968"},{"messageId":"1963","fix":"1998","desc":"1965"},{"messageId"
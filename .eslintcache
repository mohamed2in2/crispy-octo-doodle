 not to update as expected (https://react.dev/reference/react/useRef).\n\n/home/runner/work/crispy-octo-doodle/crispy-octo-doodle/src/app/(clerk)/environments/physics/page.tsx:541:39\n  539 |         maxLevel={levelsRef.current.length > 0 ? Math.max(...levelsRef.current) : 1}\n  540 |         maxStreak={maxStreakRef.current}\n> 541 |         difficulty={levelToDifficulty(levelRef.current)}\n      |                                       ^^^^^^^^^^^^^^^^ Passing a ref to a function may read its value during render\n  542 |         autoLoad\n  543 |       />\n  544 |       <div className=\"flex gap-3 mt-3\">","React Hook useEffect has a missing dependency: 'runCode'. Either include it or remove the dependency array.",["5524"],"'isEasy' is assigned a value but never used.","'isMedium' is assigned a value but never used.","Error: Cannot access variable before it is declared\n\n`nextQ` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\n/home/runner/work/crispy-octo-doodle/crispy-octo-doodle/src/app/(clerk)/environments/programming/page.tsx:488:43\n  486 |         tStartRef.current = now;\n  487 |         streakRef.current = 0;\n> 488 |         advRef.current = setTimeout(() => nextQ(idx + 1), 1500);\n      |                                           ^^^^^ `nextQ` accessed before it is declared\n  489 |       }\n  490 |     }, 100);\n  491 |     tStartRef.current = Date.now();\n\n/home/runner/work/crispy-octo-doodle/crispy-octo-doodle/src/app/(clerk)/environments/programming/page.tsx:446:3\n  444 |   };\n  445 |\n> 446 |   const nextQ = useCallback((idx: number) => {\n      |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 447 |     if (idx >= TOTAL_Q) {\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^\n> 448 |       const avgLevel = levelsRef.current.reduce((a, b) => a + b, 0) / levelsRef.current.length;\n      …\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^\n> 492 |   // eslint-disable-next-line react-hooks/exhaustive-deps\n
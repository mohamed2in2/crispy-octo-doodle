rnal systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nJ:\\crispy-octo-doodle-1\\src\\app\\(clerk)\\account\\page.tsx:103:5\n  101 |\n  102 |   useEffect(() => {\n> 103 |     setIqData(getIQData());\n      |     ^^^^^^^^^ Avoid calling setState() directly within an effect\n  104 |     const handler = () => setIqData(getIQData());\n  105 |     window.addEventListener(\"storage\", handler);\n  106 |     return () => window.removeEventListener(\"storage\", handler);","react-hooks/exhaustive-deps","React Hook useCallback has a missing dependency: 'EMPTY_STATS'. Either include it or remove the dependency array.","ArrayExpression",["2713"],["2714"],"'Footer' is defined but never used.",["2715"],"'AnimatePresence' is defined but never used.",["2716"],"prefer-const","'alleles' is never reassigned. Use 'const' instead.","useConst",{"range":"2717","text":"2718"},"react-hooks/immutability","Error: Cannot access variable before it is declared\n\n`nextQ` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nJ:\\crispy-octo-doodle-1\\src\\app\\(clerk)\\environments\\biology\\page.tsx:577:43\n  575 |         tStartRef.current = now;\n  576 |         streakRef.current = 0;\n> 577 |         advRef.current = setTimeout(() => nextQ(idx + 1), 1500);\n      |                                           ^^^^^ `nextQ` accessed before it is declared\n  578 |       }\n  579 |     }, 100);\n  580 |     tStartRef.current = Date.now();\n\nJ:\\crispy-octo-doodle-1\\src\\app\\(clerk)\\environments\\biology\\page.tsx:535:3\n  533 |   };\n  534 |\n> 535 |   const nextQ = useCallback((idx: number) => {\n      |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 536 |     if (idx >= TOTAL_Q) {\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^\n> 537 |       const avgLevel = levelsRef.current.reduce((a, b) => a + b, 0) / levelsRef.current.length;\n      …\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^\n> 581 |   // eslint-disable-next-line react-hooks/exhaustive-deps\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^\n> 582 |   }, [onFinish]);\n      | ^^^^^^^^^^^^^^^^^^ `nextQ` is declared here\n  583 |\n  584 |   const start = () => {\n  585 |     clear();","Unused eslint-disable directive (no problems were reported from 'react-hooks/exhaustive-deps').",{"range":"2719","text":"2720"},{"range":"2721","text":"2720"},"react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nJ:\\crispy-octo-doodle-1\\src\\app\\(clerk)\\environments\\biology\\page.tsx:673:85\n  671 |       <div style={{ fontSize: 52 }}>{result.correct >= 8 ? \"🏆\" : result.correct >= 5 ? \"⭐\" : \"💪\"}</div>\n  672 |       <h3 className=\"text-2xl font-black mb-1\" style={{ color: \"var(--ink)\" }}>{result.correct}/{TOTAL_Q} صحيح</h3>\n> 673 |       <p className=\"text-xs text-gray-500 mb-3\">أعلى مستوى وصلت له: Lv.{Math.max(...levelsRef.current)}</p>\n      |                                                                                     ^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  674 |       <div className=\"rounded-xl p-4 my-4\" style={{ background: \"var(--brand-soft)\", border: \"1px solid var(--brand)\" }}>\n  675 |         <div className=\"text-xs font-bold mb-1\" style={{ color: \"var(--brand)\" }}>نقاط الجلسة</div>\n  676 |         <div className=\"text-3xl font-black\" style={{ color: \"var(--brand)\" }}>{result.sessionScore.toLocaleString(\"ar-EG\")}</div>","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nJ:\\crispy-octo-doodle-1\\src\\app\\(clerk)\\environments\\biology\\page.tsx:683:22\n  681 |         correctAnswers={result.correct}\n  682 |         totalQuestions={TOTAL_Q}\n> 683 |         totalTimeMs={totalMsRef.current}\n      |                      ^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  684 |         maxLevel={levelsRef.current.length > 0 ? Math.max(...levelsRef.current) : 1}\n  685 |         maxStreak={maxStreakRef.current}\n  686 |         difficulty={levelToDifficulty(levelRef.current)}","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nJ:\\crispy-octo-doodle-1\\src\\app\\(clerk)\\environments\\biology\\page.tsx:684:19\n  682 |         totalQuestions={TOTAL_Q}\n  683 |         totalTimeMs={totalMsRef.current}\n> 684 |         maxLevel={levelsRef.current.length > 0 ? Math.max(...levelsRef.current) : 1}\n      |                   ^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  685 |         maxStreak={maxStreakRef.current}\n  686 |         difficulty={levelToDifficulty(levelRef.current)}\n  687 |         autoLoad","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component
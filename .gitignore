# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local databases (never commit — they contain real user rows)
*.db
*.db-journal
*.sqlite
*.sqlite3
/dev.db
/dev.db-journal
/prisma/*.db
/prisma/*.db-journal

# logs and captured command output
*.log
/logs/
dev-server.log
build-out.txt
test-out.txt

# agent execution transcripts and captured tool output
/agents/**/wire.jsonl
/agents/**/logs/

# binary artifacts and archives (use releases, not git)
*.deb
*.deb.[0-9]
*.rpm
*.exe
*.dmg
*.msi
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# editor / IDE local state
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json

# backups and scratch files
*.backup
*.bak
*.orig
*.rej

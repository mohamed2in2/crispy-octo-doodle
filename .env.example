# Code-UP environment configuration
# Copy to `.env` or `.env.local`; never commit a real secret.

# Database: local SQLite for development only.
DATABASE_URL="file:./dev.db"
# Production uses PostgreSQL and a direct migration URL.
# DATABASE_URL="postgresql://application-user:password@db-host:5432/codeup"
# DIRECT_URL="postgresql://migration-user:password@db-host:5432/codeup"

# Authentication and server security. Generate each independently:
# openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"
CRON_SECRET="replace-with-a-long-random-secret-min-32-chars"
# Stable 32+ character encryption secret. Do not rotate without re-encrypting saved AI keys.
CONFIG_ENCRYPTION_KEY="replace-with-a-stable-random-secret-min-32-chars"

# Canonical URLs. Production must use HTTPS.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
#credits 2n2 dev kemetcraft.me
# SMS verification — bypass switches are local-only and must stay false in production.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-your-auth-token"
TWILIO_FROM_NUMBER="+201XXXXXXXXX"
TWILIO_BYPASS_VERIFICATION="false"
BYPASS_PHONE_VERIFICATION="false"
DEV_SKIP_SMS="false"

# Admin break-glass and destructive-action passwords — server-only.
SUPERADMIN_MASTER_PASSWORD="change-me"
SUPERADMIN_ACTION_PASSWORD="replace-with-strong-random-password"
ADMIN_ACTION_PASSWORD="replace-with-admin-password"
BULK_DELETE_PASSWORD="replace-with-bulk-delete-password"
WALLET_PASSWORD="replace-with-wallet-password"

# reCAPTCHA Enterprise: required for production login and device-reset endpoints.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-enterprise-site-key"
RECAPTCHA_API_KEY="your-google-cloud-api-key"
RECAPTCHA_BYPASS="false"

# Bunny Stream / CDN (optional video playback)
BUNNY_LIBRARY_ID="650875"
BUNNY_API_KEY=""
BUNNY_TOKEN_KEY=""
BUNNY_CDN_HOSTNAME="vz-a3ef6e25-703.b-cdn.net"
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_TOKEN_AUTH_KEY=""
BUNNY_EMBED_SIGNING_ENABLED="false"
NEXT_PUBLIC_BUNNY_LIBRARY_ID="666960"

# AI study assistant (optional)
AI_PRIMARY_API_KEY=""
AI_PRIMARY_BASE_URL="https://api.anthropic.com/v1/messages"
AI_PRIMARY_MODEL="claude-3-5-sonnet-20241022"
AI_BACKUP_API_KEY=""
AI_BACKUP_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
AI_BACKUP_MODEL="gemini-2.0-flash-lite"

# WhatsApp Business API (optional)
WHATSAPP_API_VERSION="v25.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_PERMANENT_TOKEN=""
WHATSAPP_OTP_TEMPLATE_NAME="codeup_otp_login"
WHATSAPP_OTP_TEMPLATE_LANG="ar"

# Sha7nawy Payment Gateway
SHA7NAWY_BASE_URL="https://gate.sha7nawy.com"
SHA7NAWY_PUBLIC_KEY="your-sha7nawy-public-key"
SHA7NAWY_SECRET_KEY="your-sha7nawy-secret-key"

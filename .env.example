# =============================================================================
# Code-UP — environment variables
# Copy to `.env.local` for local development. Never commit `.env` or `.env.local`.
# All values below are examples only; replace them before deployment.
# =============================================================================

# --- Database ---
# Local development may use SQLite.
DATABASE_URL="file:./dev.db"
# Production requires PostgreSQL for BOTH connection paths. Do not use SQLite.
# DATABASE_URL="postgresql://app_user:REPLACE@db.example.com:5432/codeup?sslmode=require"
# DIRECT_URL="postgresql://app_user:REPLACE@db.example.com:5432/codeup?sslmode=require"

# --- Required secrets ---
# Use at least 32 random characters: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"
# Required for scheduled jobs and internal cron endpoints.
CRON_SECRET="replace-with-a-long-random-secret-min-32-chars"
# At least 32 stable characters. Changing it makes encrypted saved AI keys unreadable.
CONFIG_ENCRYPTION_KEY="replace-with-a-stable-long-random-secret-min-32-chars"

# --- Canonical app URLs ---
# Production must use the public HTTPS URL (for example, https://app.example.com).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Twilio SMS verification ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-your-auth-token"
TWILIO_FROM_NUMBER="+201XXXXXXXXX"

# LOCAL DEVELOPMENT ONLY. These bypass flags must remain "false" and are rejected
# by production validation when truthy: BYPASS_PHONE_VERIFICATION, DEV_SKIP_SMS,
# TWILIO_BYPASS_VERIFICATION, and RECAPTCHA_BYPASS.
TWILIO_BYPASS_VERIFICATION="false"
RECAPTCHA_BYPASS="false"

# --- reCAPTCHA Enterprise (required in production) ---
# Public site key — safe to expose in the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-enterprise-site-key"
# Server-only Google Cloud API key. Enable the reCAPTCHA Enterprise API.
RECAPTCHA_API_KEY="your-google-cloud-api-key"

# --- Admin break-glass and action gates ---
# Store real values only in the deployment secret manager, never in source control.
SUPERADMIN_MASTER_PASSWORD="replace-with-a-strong-break-glass-password"
SUPERADMIN_ACTION_PASSWORD="replace-with-a-strong-action-password"
ADMIN_ACTION_PASSWORD="replace-with-a-strong-admin-password"

# --- Public support contact ---
# This value is deliberately public and must be a WhatsApp phone number, not a password.
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER="+201285353604"

# --- Bunny Stream / CDN (optional video playback) ---
BUNNY_LIBRARY_ID=""
BUNNY_API_KEY=""
BUNNY_TOKEN_KEY=""
BUNNY_CDN_HOSTNAME=""
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_TOKEN_AUTH_KEY=""
BUNNY_EMBED_SIGNING_ENABLED="false"
NEXT_PUBLIC_BUNNY_LIBRARY_ID=""

# --- AI study assistant (optional) ---
AI_PRIMARY_API_KEY=""
AI_PRIMARY_BASE_URL="https://api.anthropic.com/v1/messages"
AI_PRIMARY_MODEL="claude-3-5-sonnet-20241022"
AI_BACKUP_API_KEY=""
AI_BACKUP_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
AI_BACKUP_MODEL="gemini-2.0-flash-lite"

# --- WhatsApp Business API ---
WHATSAPP_API_VERSION="v25.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_PERMANENT_TOKEN=""
WHATSAPP_OTP_TEMPLATE_NAME="codeup_otp_login"
WHATSAPP_OTP_TEMPLATE_LANG="ar"

# --- Sha7nawy payment gateway: Vodafone Cash, Etisalat Cash, Orange Cash only ---
SHA7NAWY_BASE_URL="https://gate.sha7nawy.com"
SHA7NAWY_PUBLIC_KEY="your-sha7nawy-public-key"
SHA7NAWY_SECRET_KEY="your-sha7nawy-secret-key"

# --- Shake-Out payment gateway: Fawry only ---
SHAKEOUT_BASE_URL="https://dash.shake-out.com"
SHAKEOUT_PUBLIC_KEY="your-shakeout-public-key"
SHAKEOUT_SECRET_KEY="your-shakeout-secret-key"
